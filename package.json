{
  "name": "gstin-check",
  "version": "1.0.0",
  "private": true,
  "description": "PWA that reads a GSTIN off a bill and says whether the supplier may legally collect GST.",
  "scripts": {
    "serve": "go run server.go",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node tools/e2e.mjs",
    "e2e:headed": "node tools/e2e.mjs --headed",
    "crosscheck": "node tools/crosscheck.mjs",
    "bills": "uv run --with pillow python tools/make_sample_bill.py",
    "icons": "uv run --with pillow python tools/make_icons.py",
    "audit": "python3 tools/privacy_audit.py --root . --fail-on medium --forbid-file .privacy-terms",
    "version:check": "node tools/bump_version.mjs --check",
    "version:bump": "node tools/bump_version.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
